+dtb-$(CONFIG_ARCH_QCOM)	+= sm8650-nubia-cerro.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8650-qrd.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sm8750-mtp.dtb
diff --git a/arch/arm64/boot/dts/qcom/sm8650-nubia-cerro.dts b/arch/arm64/boot/dts/qcom/sm8650-nubia-cerro.dts
new file mode 100644
index 0000000..5766ad5
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8650-nubia-cerro.dts
@@ -0,0 +1,628 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Nubia Z60 Ultra (cerro / NX721J) mainline device tree.
+ *
+ * Provenance of the hardware facts:
+ *   - Extracted offline from the stock firmware dump
+ *     (see ../notes/cerro-hardware.md, ../downstream-dt/dts/dtbo_1.dts).
+ *   - Cross-checked against the upstream SM8650 QRD reference board
+ *     (arch/arm64/boot/dts/qcom/sm8650-qrd.dts), which carries the
+ *     *identical* Visionox VTDR6130 panel and Goodix Berlin touch on
+ *     spi4 (reset gpio161 / irq gpio162), UFS and USB wiring. cerro's
+ *     display/touch/storage path is therefore a 1:1 match with the QRD.
+ *
+ * Scope: this is a first bring-up tree (console + storage + USB +
+ * display + touch). Nubia-specific extras that are not needed to boot
+ * pmOS to a display are intentionally omitted and listed at the bottom.
+ *
+ * Copyright (c) 2023, Linaro Limited (QRD reference)
+ * Copyright (c) 2026, Nubia Z60U mainline port
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include "sm8650.dtsi"
+#include "pm8550.dtsi"
+#include "pm8550b.dtsi"
+#define PMK8550VE_SID 8
+#include "pm8550ve.dtsi"
+#include "pm8550vs.dtsi"
