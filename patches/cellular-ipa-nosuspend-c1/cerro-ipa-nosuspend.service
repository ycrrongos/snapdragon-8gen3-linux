[Unit]
Description=Cerro: disable IPA runtime autosuspend (GSI STOP hang workaround)
DefaultDependencies=no
After=sysinit.target
Before=cerro-memshare.service cerro-remoteproc-prepare.service ModemManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for i in $(seq 1 120); do if [ -e /sys/devices/platform/soc@0/3f40000.ipa/power/control ]; then echo on > /sys/devices/platform/soc@0/3f40000.ipa/power/control; echo -1 > /sys/devices/platform/soc@0/3f40000.ipa/power/autosuspend_delay_ms 2>/dev/null || true; exit 0; fi; sleep 0.5; done; exit 1'

[Install]
WantedBy=multi-user.target
