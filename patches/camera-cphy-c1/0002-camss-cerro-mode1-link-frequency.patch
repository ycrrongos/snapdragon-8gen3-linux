From af975f9ca6fe313f36514ab3012b23b0456c08f4 Mon Sep 17 00:00:00 2001
From: AviumSmartisanOS <asos@localhost>
Date: Tue, 10 Nov 2026 16:58:09 +0800
Subject: [PATCH] media: camss: admit the audited Cerro 1GHz C-PHY mode

---
 drivers/media/platform/qcom/camss/camss-csiphy.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/qcom/camss/camss-csiphy.c b/drivers/media/platform/qcom/camss/camss-csiphy.c
index b6916bd52..85c9174b9 100644
--- a/drivers/media/platform/qcom/camss/camss-csiphy.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy.c
@@ -159,7 +159,9 @@ static int csiphy_set_clock_rates(struct csiphy_device *csiphy)
 			/* v2.2.0 stock C-PHY vote is per-trio bit rate/32. */
 			if (csiphy->camss->res->version == CAMSS_8650 &&
 			    csiphy->cfg.csi2->lane_cfg.phy_cfg == V4L2_MBUS_CSI2_CPHY) {
-				if (link_freq != 998000000LL)
+				/* Audited Cerro mode7 and mode1 OP PLL clocks. */
+				if (link_freq != 998000000LL &&
+				    link_freq != 1000000000LL)
 					return -EINVAL;
 				min_rate = div_u64((u64)link_freq * 2 * 16, 7 * 32);
 			} else {
-- 
2.56.0

