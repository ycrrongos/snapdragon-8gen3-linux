+
+/* Default QMI clients use the primary logical subscription.  More than one
+ * physical slot may be ACTIVE on DSDS devices; array order must not select
+ * the last active (secondary) SIM as the modem's primary SIM. */
+static guint
+find_primary_active_slot (GArray *physical_slots)
+{
+    guint primary_slot = 0;
+    guint primary_logical_id = G_MAXUINT;
+    guint i;
+
+    for (i = 0; i < physical_slots->len; i++) {
+        QmiPhysicalSlotStatusSlot *slot;
+
+        slot = &g_array_index (physical_slots, QmiPhysicalSlotStatusSlot, i);
+        if (slot->physical_slot_status != QMI_UIM_SLOT_STATE_ACTIVE || !slot->logical_slot)
+            continue;
+        if (slot->logical_slot < primary_logical_id) {
+            primary_logical_id = slot->logical_slot;
+            primary_slot = i + 1;
+        }
+    }
+    return primary_slot;
 }
 
