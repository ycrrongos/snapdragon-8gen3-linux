+	ts_spi_mosi_clk: ts-spi-mosi-clk-state {
+		pins = "gpio49", "gpio50";
+		function = "qup1_se4";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	/* s5di: native CS (was ts_spi_cs_gpio in s5dg) */
+	ts_spi_cs_hw: ts-spi-cs-hw-state {
+		pins = "gpio51";
+		function = "qup1_se4";
+		drive-strength = <8>;
+		bias-disable;
+	};
