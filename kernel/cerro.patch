+static void cerro_pcie_enable_cesta_parf(struct qcom_pcie *pcie)
+{
+	u32 val, nval;
+
+	val = readl(pcie->parf + PARF_CESTA_CLKREQ_CFG);
+	nval = val | PARF_CESTA_CLKREQ_SEL | PARF_CESTA_L1SUB_TIMEOUT_EXT_INT_EN;
+	writel(nval, pcie->parf + PARF_CESTA_CLKREQ_CFG);
+	dev_info(pcie->pci->dev,
+		 "cerro: PARF_CESTA_CLKREQ_CFG 0x%x -> 0x%x (SEL+L1TO)\n",
+		 val, readl(pcie->parf + PARF_CESTA_CLKREQ_CFG));
+}
+
+/*
+ * Minimal CRM HW-DRV0 → CESTA D0 vote matching AOSP
+ * msm_pcie_enable_cesta() / msm_pcie_cesta_map_apply(D0_STATE).
+ * Offsets from AOSP drivers/soc/qcom/crm.c (qcom,pcie-crm).
+ */
+static int cerro_pcie_crm_d0(struct qcom_pcie *pcie)
+{
+	void __iomem *base, *crmc;
+	u32 crm_en, crm_cfg, num_ch, num_pwr, num_perf;
+	u32 chn_update, ch, drv_id = 0;
+	u32 pwr_off[2] = { 0x0, 0x40 }; /* PWR_ST0 / PWR_ST1 */
+	u32 res, j, offset, sts;
+	int retry, ret = 0;
+
+	base = ioremap(CERRO_PCIE_CRM_PHYS, CERRO_PCIE_CRM_SIZE);
+	if (!base) {
+		dev_err(pcie->pci->dev, "cerro: CRM ioremap failed\n");
+		return -ENOMEM;
+	}
+
+	crm_en = readl(base + 0xc);
+	if (!crm_en) {
+		dev_err(pcie->pci->dev, "cerro: CRM_ENABLE=0 — skip D0 vote\n");
+		iounmap(base);
+		return -ENODEV;
+	}
+
+	crm_cfg = readl(base + 0x4);
+	num_ch = (crm_cfg >> 4) & 0xf;
+	num_pwr = crm_cfg & 0xf;
+	num_perf = (crm_cfg >> 8) & 0xf;
+	dev_info(pcie->pci->dev,
+		 "cerro: CRM en=0x%x cfg=0x%x ch=%u pwr=%u perf_vcd=%u\n",
+		 crm_en, crm_cfg, num_ch, num_pwr, num_perf);
+
+	if (!num_ch || !num_perf) {
+		dev_err(pcie->pci->dev, "cerro: CRM cfg looks empty\n");
+		iounmap(base);
+		return -EINVAL;
+	}
+
+	/* Select free channel (CHN_UPDATE @ 0x1020 + drv*4) */
+	chn_update = readl(base + 0x1020 + drv_id * 4);
+	if (!chn_update)
+		ch = 0;
+	else if (chn_update & BIT(0))
+		ch = 1;
+	else if (chn_update & BIT(1))
+		ch = 0;
+	else {
+		dev_err(pcie->pci->dev, "cerro: CRM no free channel (upd=0x%x)\n",
+			chn_update);
+		iounmap(base);
+		return -EBUSY;
+	}
+
+	/*
+	 * PERF_OL VCD: DRV_BASE=0x200, DRV_DISTANCE=0x200,
+	 * DRV_RESOURCE_DISTANCE=0x4, PWR_ST_CHN_DISTANCE=0x4
+	 * Vote GEN4 for every PERF resource so sibling RCDs are not left D3.
+	 * Only POWER_STATE_0/1 are used by AOSP MAX_POWER_STATE.
+	 */
+	for (res = 0; res < num_perf; res++) {
+		for (j = 0; j < 2 && j < num_pwr; j++) {
+			offset = 0x200 + drv_id * 0x200;
+			offset += pwr_off[j];
+			offset += ch * num_perf * 4;
+			offset += res * 4;
+			writel(CERRO_CESTA_PERF_GEN4, base + offset);
+		}
+	}
+	wmb();
+
+	/* Channel switch */
+	writel(BIT(ch), base + 0x1020 + drv_id * 4);
+	retry = 100;
+	do {
+		sts = readl(base + 0x1000 + drv_id * 4);
+		if (ch == 0)
+			sts &= BIT(0);
+		else
+			sts &= BIT(1);
+		udelay(100);
+	} while (sts != BIT(ch) && --retry);
+
+	if (!retry) {
+		dev_err(pcie->pci->dev,
+			"cerro: CRM channel switch timeout ch=%u busy=0x%x\n",
+			ch, readl(base + 0x1000 + drv_id * 4));
+		ret = -EBUSY;
+	}
+
+	crmc = ioremap(CERRO_PCIE_CRMC_PHYS, CERRO_PCIE_CRMC_SIZE);
+	if (crmc) {
+		/* CURR_PERF_OL for resource 0 @ crmc + 0xc */
+		dev_info(pcie->pci->dev,
+			 "cerro: CRM D0 ch=%u curr_perf_ol[0]=0x%x aggr=0x%x\n",
+			 ch, readl(crmc + 0xc), readl(crmc + 0x4));
+		iounmap(crmc);
+	} else {
+		dev_info(pcie->pci->dev, "cerro: CRM D0 ch=%u (crmc map fail)\n",
+			 ch);
+	}
+
+	iounmap(base);
+	return ret;
+}
+
+static void cerro_pcie_apply_phy_seq(struct qcom_pcie *pcie)
+{
+	void __iomem *phy;
+	unsigned int i;
+	u32 sts;
+	int retry = 1000;
+
+	phy = ioremap(CERRO_PCIE_PHY_PHYS, CERRO_PCIE_PHY_SIZE);
+	if (!phy) {
+		dev_err(pcie->pci->dev, "cerro: PHY ioremap failed\n");
+		return;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(cerro_pcie_phy_seq); i++) {
+		writel(cerro_pcie_phy_seq[i][1],
+		       phy + cerro_pcie_phy_seq[i][0]);
+		if (cerro_pcie_phy_seq[i][2])
+			usleep_range(cerro_pcie_phy_seq[i][2],
+				     cerro_pcie_phy_seq[i][2] + 1);
+	}
+	wmb();
+	usleep_range(1000, 1500);
+
+	do {
+		sts = readl(phy + CERRO_PCIE_PHY_STATUS_OFF);
+		if (sts & CERRO_PCIE_PHY_STATUS_BIT)
+			break;
+		usleep_range(1000, 1500);
+	} while (--retry);
+
+	dev_info(pcie->pci->dev,
+		 "cerro: phy-seq %zu applied status@0x214=0x%x %s\n",
+		 ARRAY_SIZE(cerro_pcie_phy_seq), sts,
+		 (sts & CERRO_PCIE_PHY_STATUS_BIT) ? "ready" : "NOT-ready");
+	iounmap(phy);
+}
+
+static void cerro_pcie_sm_init(struct qcom_pcie *pcie)
+{
+	void __iomem *sm;
+	int i;
+	u32 start;
+
+	sm = ioremap(CERRO_PCIE_SM_PHYS, CERRO_PCIE_SM_SIZE);
+	if (!sm) {
+		dev_err(pcie->pci->dev, "cerro: pcie_sm ioremap failed\n");
+		return;
+	}
+
+	/* Match AOSP module_init early PWR overrides */
+	for (i = 0; i < CERRO_PCIE_SM_NUM_INST; i++) {
+		u32 off = i * CERRO_PCIE_SM_INST_STRIDE;
+
+		writel(0x1, sm + CERRO_PCIE_SM_PWR_CTRL + off);
+		writel(0x1, sm + CERRO_PCIE_SM_PWR_MASK + off);
+	}
+	wmb();
+
+	/* msm_pcie_cesta_load_sm_seq: drop overrides, load microcode, start */
+	for (i = 0; i < CERRO_PCIE_SM_NUM_INST; i++) {
+		u32 off = i * CERRO_PCIE_SM_INST_STRIDE;
+
+		writel(0x0, sm + CERRO_PCIE_SM_PWR_CTRL + off);
+		writel(0x0, sm + CERRO_PCIE_SM_PWR_MASK + off);
+	}
+	for (i = 0; i < ARRAY_SIZE(cerro_pcie_sm_seq); i++)
+		writel(cerro_pcie_sm_seq[i], sm + 4 * i);
+	for (i = 0; i < ARRAY_SIZE(cerro_pcie_sm_branch_seq); i++)
+		writel(cerro_pcie_sm_branch_seq[i],
+		       sm + CERRO_PCIE_SM_BRANCH_OFF + 4 * i);
+	start = readl(sm + CERRO_PCIE_SM_START_OFF);
+	writel(start | BIT(0), sm + CERRO_PCIE_SM_START_OFF);
+	wmb();
+
+	dev_info(pcie->pci->dev,
+		 "cerro: pcie_sm seq loaded start=0x%x i0ctrl=0x%x i0mask=0x%x\n",
+		 readl(sm + CERRO_PCIE_SM_START_OFF),
+		 readl(sm + CERRO_PCIE_SM_PWR_CTRL),
+		 readl(sm + CERRO_PCIE_SM_PWR_MASK));
+	iounmap(sm);
+}
