 {
 	u32 val;
 
+	/* s5eo: vote D0 again immediately before LTSSM */
+	cerro_pcie_crm_d0(pcie);
+	cerro_pcie_enable_cesta_parf(pcie);
+	cerro_pcie_sm_init(pcie);
+
 	/* enable link training */
 	val = readl(pcie->parf + PARF_LTSSM);
 	val |= LTSSM_EN;
@@ -1073,6 +1446,19 @@ static int qcom_pcie_init_2_7_0(struct qcom_pcie *pcie)
