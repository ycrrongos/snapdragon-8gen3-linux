+	/*
+	 * s5di: QRD-style native HW CS (gpio51 = qup1_se4), keep s5dg MISO
+	 * pull-up so float reads 0xff. (s5dg used cs-gpios; still mute.)
+	 */
+	pinctrl-0 = <&ts_spi_miso>, <&ts_spi_mosi_clk>, <&ts_spi_cs_hw>;
+	pinctrl-names = "default";
+
+	touchscreen@0 {
+		compatible = "goodix,gt9916";
+		reg = <0>;
+
+		interrupt-parent = <&tlmm>;
+		/*
+		 * Vendor irq-flags=0x02 (EDGE_FALLING). QRD uses LEVEL_LOW;
+		 * keep EDGE_FALLING to match Cerro DTBO.
+		 */
+		interrupts = <162 IRQ_TYPE_EDGE_FALLING>;
+
+		/*
+		 * Vendor requests reset with GPIOF_OUT_INIT_LOW and later
+		 * drives gpio=1 to run — physical HIGH = release.
+		 * That matches GPIO_ACTIVE_LOW (assert=LOW).
+		 * (s5db ACTIVE_HIGH also failed confirm.)
+		 */
+		reset-gpios = <&tlmm 161 GPIO_ACTIVE_LOW>;
+		/* s5dj: drive during reset; same pin as interrupts */
+		irq-gpios = <&tlmm 162 GPIO_ACTIVE_HIGH>;
+
+		/* s5dk: brl-d AVDD=gpio28 load-switch; IOVDD=L12B (AOSP pm_humu_l12) */
+		avdd-supply = <&ts_avdd>;
+		vddio-supply = <&vreg_l12b_1p8>;
+
+		/* Live brl-d node: 20MHz (gt9916S disabled path was 1MHz) */
+		spi-max-frequency = <20000000>;
+
+		/*
+		 * AOSP brl-d: goodix,panel-max-x/y = 0x45c0 / 0x9b00
+		 * (= 16 × 1116 × 2480). IC reports in that space; s5dl used
+		 * 1116×2480 so ABS max was too small (raw Y saw >2479).
+		 */
+		touchscreen-size-x = <17856>;
+		touchscreen-size-y = <39680>;
+
+		pinctrl-0 = <&ts_irq>, <&ts_reset>, <&ts_avdd_gpio>;
+		pinctrl-names = "default";
+	};
+};
