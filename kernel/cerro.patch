+		/* cerro dtbo: qcom,wlan-sw-ctrl-gpio = tlmm 19 (QRD has only 18) */
+		wlan-sw-ctrl-pins {
+			pins = "gpio19";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-disable;
+		};
+	};
