+	/* s5ex: WCD939x reset (vb_04 / QRD gpio107) */
+	wcd_default: wcd-reset-n-active-state {
+		pins = "gpio107";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-low;
+	};
+
+	/*
+	 * s5fu: AOSP/stock pri_mi2s / i2s0 (vb_03 aux0_pcm_*).
+	 * gpio126 sck, 129 ws, 127 data0, 128 data1 — drive 8 like vendor active.
+	 */
+	pri_mi2s_active: pri-mi2s-active-state {
+		sck-pins {
+			pins = "gpio126";
+			function = "i2s0_sck";
+			drive-strength = <8>;
+			bias-disable;
+			output-high;
+		};
+
+		ws-pins {
+			pins = "gpio129";
+			function = "i2s0_ws";
+			drive-strength = <8>;
+			bias-disable;
+			output-high;
+		};
+
+		data0-pins {
+			pins = "gpio127";
+			function = "i2s0_data0";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		data1-pins {
+			pins = "gpio128";
+			function = "i2s0_data1";
+			drive-strength = <8>;
+			bias-disable;
+		};
+	};
+
+	/* s5fk: match downstream aud_active (output-high). SD_N is ACTIVE_LOW
+	 * in powerdown-gpios; physical HIGH = out of shutdown. QRD mainline
+	 * uses output-low + driver deassert; on cerro WSA stayed UNATTACHED
+	 * with left LPASS21 stuck low — try board-faithful pinctrl first.
+	 */
+	spkr_2_sd_n_active: spkr-2-sd-n-active-state {
+		pins = "gpio77";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-high;
+	};
+
+	/* s5fq: drop spkr_2_sd_n_hog — restore powerdown-gpios consumer */
+
+	bt_default: bt-default-state {
+		bt-en-pins {
+			pins = "gpio17";
+			function = "gpio";
+			drive-strength = <16>;
+			bias-disable;
+		};
+
+		/* s5eh: drive high via pwrseq; drop pull-down that left pins low when undriven */
+		sw-ctrl-pins {
+			pins = "gpio18";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-disable;
+		};
