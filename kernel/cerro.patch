+&pcieport0 {
+	/* s5eb: match QRD (drop Gen1/lane overrides; s5ea still DNF) */
+	t-power-on-us = <200000>;
+
+	wifi@0 {
+		compatible = "pci17cb,1107";
+		reg = <0x10000 0x0 0x0 0x0 0x0>;
+
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
+		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
+		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;
+	};
+};
+
+&pcie0_phy {
+	vdda-phy-supply = <&vreg_l1i_0p88>;
+	vdda-pll-supply = <&vreg_l3i_1p2>;
+
+	status = "okay";
+};
+
+/*
+ * Cellular candidate 1: use the upstream SM8650 4 MiB rmtfs reservation at
+ * 0xd7c00000 (the Cerro stock map leaves the range before tz@d8000000 free).
+ * Userspace starts this auto_boot=false remoteproc only after publishing the
+ * read-only raw-partition RMTFS service.
+ */
+&ipa {
+	qcom,gsi-loader = "self";
+	memory-region = <&ipa_fw_mem>;
+	firmware-name = "qcom/sm8650/ipa_fws.mdt";
+
+	status = "okay";
+};
+
+/*
+ * Stock pineapple-ipa.dtbo adds an identity mapping 0x14683000..0x14684fff
+ * to the IPA AP SMMU context (SID 0x4a0).  The IPA driver only identity-maps
+ * this DT sram window, so the mainline modem-tables@8000 default left the
+ * stock-required IOVA 0x14684080 unmapped: every boot produced the same
+ * apps-SMMU translation fault (FSR 0x402, cb5) followed by whole-device
+ * hard resets.  Moving the window to the stock offset 0x3000 eliminates the
+ * fault and the reset loop (stability-ipa-imem-c1, verified 2026-08-19).
+ */
+&ipa_modem_tables {
+	reg = <0x3000 0x2000>;
+};
+
+&remoteproc_mpss {
+	firmware-name = "qcom/sm8650/modem.mdt",
+			"qcom/sm8650/modem_dtb.mdt";
+
+	status = "okay";
+};
+
+/*
+ * Cerro stock MPSS queries Dynamic Heap Memory Sharing client 1 and requests
+ * exactly 5 MiB before IPA/DMS initialization.  Keep all five stock clients;
+ * the service driver is loaded before qcom_q6v5_pas starts the modem.
+ */
+&soc {
+	qcom,memshare {
+		compatible = "qcom,memshare";
+
+		qcom,client_1 {
+			compatible = "qcom,memshare-peripheral";
+			qcom,peripheral-size = <0>;
+			qcom,client-id = <0>;
+			qcom,allocate-boot-time;
+			label = "modem";
+		};
+
+		qcom,client_2 {
+			compatible = "qcom,memshare-peripheral";
+			qcom,peripheral-size = <0>;
+			qcom,client-id = <2>;
+			label = "modem";
+		};
+
+		qcom,client_3 {
+			compatible = "qcom,memshare-peripheral";
+			qcom,peripheral-size = <0x00500000>;
+			qcom,client-id = <1>;
+			qcom,allocate-on-request;
+			label = "modem";
+		};
+
+		qcom,client_4 {
+			compatible = "qcom,memshare-peripheral";
+			qcom,peripheral-size = <0x01000000>;
+			qcom,client-id = <5>;
+			qcom,allocate-on-request;
+			qcom,shared;
+			memory-region = <&qmc_dma_region>;
+			label = "modem";
+		};
+
+		qcom,client_5 {
+			compatible = "qcom,memshare-peripheral";
+			qcom,peripheral-size = <0x00400000>;
+			qcom,client-id = <6>;
+			qcom,allocate-on-request;
+			qcom,shared;
+			label = "modem";
+		};
+	};
+};
+
+/* s5fc: ADSP okay but driver auto_boot=false (see qcom_q6v5_pas cerro data).
+ * cerro-audio stages modem_a fw then echo start. s5fa auto-boot hung pre-getty.
+ */
+&remoteproc_adsp {
+	firmware-name = "qcom/sm8650/adsp.mdt",
+			"qcom/sm8650/adsp_dtb.mdt";
+
+	status = "okay";
+};
+
+/*
+ * s5ff: PDR never publishes msm/adsp/audio_pd → aprbus stays empty → no q6prm
+ * clocks → va_macro deferred forever. Skip PD gate for bringup (services still
+ * talk to ADSP over GPR once registered).
+ */
+&lpass_vamacro {
+	pinctrl-0 = <&dmic01_default>, <&dmic23_default>;
+	pinctrl-names = "default";
+};
+
+&q6apm {
+	/delete-property/ qcom,protection-domain;
+};
+
+&q6prm {
+	/delete-property/ qcom,protection-domain;
+};
+
+&lpass_tlmm {
+	/* s5fk: downstream spkr_02_sd_n_active = output-high on LPASS gpio21 */
+	spkr_1_sd_n_active: spkr-1-sd-n-active-state {
+		pins = "gpio21";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+		output-high;
+	};
+
+	/* s5fq: drop spkr_1_sd_n_hog — wsa884x powerdown-gpios owns the line */
+};
+
+/*
+ * s5fr/s5fs: Cerro has no WSA884x on swr0 (AOSP/stock wsa-macro disabled).
+ * Speakers are AW88261 on &i2c_hub_3.
+ */
+&swr0 {
+	status = "disabled";
+};
+
+/*
+ * s5fs: parent hub must be okay or i2c@98c000 never probes (s5fr lesson:
+ * DT had aw88261 nodes + module loaded, but /sys/bus/i2c/devices empty).
+ */
+&i2c_master_hub_0 {
+	status = "okay";
+};
+
+/*
+ * AOSP: qupv3_hub_i2c3 @98c000, aw882xx_smartpa@34/@35, chipid 0x2113.
+ * sound-channel: @34=1 @35=0. Firmware: notes/firmware-aw882xx/aw882xx_acf.bin
+ */
+&i2c_hub_3 {
+	status = "okay";
+
+	spkr_left: audio-codec@34 {
+		compatible = "awinic,aw88261";
+		reg = <0x34>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "SpkrLeft";
+		dvdd-supply = <&vreg_l15b_1p8>;
+		awinic,audio-channel = <1>;
+		firmware-name = "aw882xx_acf.bin";
+	};
+
+	spkr_right: audio-codec@35 {
+		compatible = "awinic,aw88261";
+		reg = <0x35>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "SpkrRight";
+		dvdd-supply = <&vreg_l15b_1p8>;
+		awinic,audio-channel = <0>;
+		firmware-name = "aw882xx_acf.bin";
+	};
+};
+
+&swr1 {
+	status = "okay";
+
+	wcd_rx: codec@0,4 {
+		compatible = "sdw20217010e00";
+		reg = <0 4>;
+		qcom,rx-port-mapping = <1 2 3 4 5 9>;
+	};
+};
+
+&swr2 {
+	status = "okay";
+
+	wcd_tx: codec@0,3 {
+		compatible = "sdw20217010e00";
+		reg = <0 3>;
+		qcom,tx-port-mapping = <2 2 3 4>;
+	};
+};
+
+/* s5du: keep BT; PCIe enabled above */
+&uart14 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,wcn7850-bt";
+
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
+		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
+
+		max-speed = <3200000>;
+		/* Little-endian. Displays as 02:00:95:0B:4D:FF. */
+		local-bd-address = [ ff 4d 0b 95 00 02 ];
+	};
+};
+
+&uart15 {
+	status = "okay";
+};
+
+&ufs_mem_hc {
+	reset-gpios = <&tlmm 210 GPIO_ACTIVE_LOW>;
+
+	vcc-supply = <&vreg_l17b_2p5>;
+	vcc-max-microamp = <1300000>;
+	vccq-supply = <&vreg_l1c_1p2>;
+	vccq-max-microamp = <1200000>;
+
+	status = "okay";
+};
+
+&ufs_mem_phy {
+	vdda-phy-supply = <&vreg_l1d_0p88>;
+	vdda-pll-supply = <&vreg_l3i_1p2>;
+
+	status = "okay";
+};
