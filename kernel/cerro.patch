+&usb_1 {
+	/* Path A bring-up used peripheral-only; OTG needs dual-role + role switch
+	 * (SM8650 HDK/MTP). pmic-glink connector already data-role/power-role dual. */
+	dr_mode = "otg";
+	usb-role-switch;
+
+	status = "okay";
+};
