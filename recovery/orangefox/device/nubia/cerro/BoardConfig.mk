#
# OrangeFox/TWRP BoardConfig for nubia cerro (NX721J / SM8650 pineapple)
# Align with ArtistAOSP sm8650-common + OP12/waffle stock recovery path:
# BOARD_EXCLUDE_KERNEL_FROM_RECOVERY_IMAGE — ABL loads boot kernel + recovery ramdisk.
# Embedding a kernel in recovery.img → immediate return to fastboot (2026-10-15 实机).
#

DEVICE_PATH := device/nubia/cerro
PREBUILT_PATH := $(DEVICE_PATH)/prebuilt

# Architecture
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-2a-dotprod
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_VARIANT := cortex-a55
TARGET_SUPPORTS_64_BIT_APPS := true
TARGET_KERNEL_ARCH := arm64
TARGET_KERNEL_HEADER_ARCH := arm64

# Bootloader / platform
TARGET_BOOTLOADER_BOARD_NAME := pineapple
TARGET_NO_BOOTLOADER := true
TARGET_BOARD_PLATFORM := pineapple
QCOM_BOARD_PLATFORMS += pineapple

# Kernel (build-time prebuilt only; NOT packed into recovery.img)
BOARD_KERNEL_BASE := 0x00000000
BOARD_KERNEL_PAGESIZE := 4096
BOARD_BOOT_HEADER_VERSION := 4
BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOT_HEADER_VERSION)
BOARD_RAMDISK_USE_LZ4 := true
BOARD_EXCLUDE_KERNEL_FROM_RECOVERY_IMAGE := true
TARGET_PREBUILT_KERNEL := $(PREBUILT_PATH)/Image
BOARD_KERNEL_IMAGE_NAME := Image
TARGET_NO_KERNEL_OVERRIDE := false
TARGET_FORCE_PREBUILT_KERNEL := true
TARGET_KERNEL_SOURCE :=
# Do NOT set BOARD_INCLUDE_DTB_IN_BOOTIMG at all.
# AOSP Makefile uses `ifdef` (not ifeq true): `:= false` still injects --dtb
# and requires PRODUCT_OUT/dtb.img (2026-10-15 ofox ninja FAIL).

BOARD_BOOTCONFIG := \
    androidboot.hardware=qcom \
    androidboot.memcg=1 \
    androidboot.usbcontroller=a600000.dwc3

# Partitions (sizes from ArtistAOSP BoardConfigCommon)
BOARD_FLASH_BLOCK_SIZE := 262144
BOARD_BOOTIMAGE_PARTITION_SIZE := 100663296
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 104857600
BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE := 100663296
BOARD_DTBOIMG_PARTITION_SIZE := 25165824
BOARD_INIT_BOOT_IMAGE_PARTITION_SIZE := 8388608

BOARD_SUPER_PARTITION_SIZE := 12884901888
BOARD_SUPER_PARTITION_GROUPS := qti_dynamic_partitions
BOARD_QTI_DYNAMIC_PARTITIONS_PARTITION_LIST := system system_ext product vendor odm system_dlkm vendor_dlkm
BOARD_QTI_DYNAMIC_PARTITIONS_SIZE := 12880707584

BOARD_USES_METADATA_PARTITION := true

# Filesystems
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true
BOARD_HAS_LARGE_FILESYSTEM := true

# Recovery
TARGET_RECOVERY_PIXEL_FORMAT := RGBX_8888
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/recovery/root/system/etc/recovery.fstab
TARGET_RECOVERY_QCOM_RTC_FIX := true
TARGET_USES_MKE2FS := true

# AVB
BOARD_AVB_ENABLE := true
BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --flags 3
BOARD_AVB_RECOVERY_KEY_PATH := external/avb/test/data/testkey_rsa4096.pem
BOARD_AVB_RECOVERY_ALGORITHM := SHA256_RSA4096
BOARD_AVB_RECOVERY_ROLLBACK_INDEX := 1
BOARD_AVB_RECOVERY_ROLLBACK_INDEX_LOCATION := 1

# TWRP / OrangeFox (waffle-adjacent SM8650 flags)
TW_THEME := portrait_hdpi
TW_EXTRA_LANGUAGES := true
TW_INPUT_BLACKLIST := "hbtp_vm"
TW_USE_TOOLBOX := true
TW_INCLUDE_REPACKTOOLS := true
TW_INCLUDE_RESETPROP := true
TW_INCLUDE_LIBRESETPROP := true
TW_INCLUDE_FASTBOOTD := true
TW_INCLUDE_FUSE_EXFAT := true
TW_INCLUDE_FUSE_NTFS := true
TW_INCLUDE_NTFS_3G := true
TW_NO_EXFAT_FUSE := true
TW_BACKUP_DATA_MEDIA := true
TW_EXCLUDE_APEX := true
TW_EXCLUDE_DEFAULT_USB_INIT := true
TW_DEFAULT_BRIGHTNESS := 800
TW_MAX_BRIGHTNESS := 2047
TW_BRIGHTNESS_PATH := "/sys/class/backlight/panel0-backlight/brightness"
TW_FRAMERATE := 60
TW_SCREEN_BLANK_ON_BOOT := true
TW_LOAD_VENDOR_MODULES := "adsp_loader_dlkm.ko q6_dlkm.ko q6_notifier_dlkm.ko q6_pdr_dlkm.ko"
TW_CUSTOM_CPU_TEMP_PATH := "/sys/devices/virtual/thermal/thermal_zone0/temp"
TW_HAS_EDL_MODE := true
TW_SUPPORT_INPUT_AIDL_HAPTICS := true
TW_USE_FSCRYPT_POLICY := 2
TW_INCLUDE_CRYPTO := true
TW_INCLUDE_CRYPTO_FBE := true
TW_INCLUDE_FBE_METADATA_DECRYPT := true
BOARD_USES_QCOM_FBE_DECRYPTION := true

# OrangeFox
OF_DEFAULT_KEYMASTER_VERSION := 4.1
OF_ENABLE_LPTOOLS := 1
OF_ENABLE_FS_COMPRESSION := 1
OF_HIDE_NOTCH := 1
OF_CLOCK_POS := 1
OF_USE_GREEN_LED := 0
OF_OPTIONS_MENU_DISABLE_AB_REBOOT_HACK := 1
OF_STATUS_INDENT_LEFT := 48
OF_STATUS_INDENT_RIGHT := 48
OF_ALLOW_DISABLE_NAVBAR := 0
OF_DONT_PATCH_ENCRYPTED_DEVICE := 1
OF_NO_TREBLE_COMPATIBILITY_CHECK := 1
OF_FORCE_PREBUILT_KERNEL := 0
OF_KEEP_FORCED_ENCRYPTION := 1
OF_AB_DEVICE_WITH_RECOVERY_PARTITION := 1
OF_USE_MAGISKBOOT := 1
OF_USE_MAGISKBOOT_FOR_ALL_PATCHES := 1
OF_DISABLE_MIUI_SPECIFIC_FEATURES := 1
OF_FLASHLIGHT_ENABLE := 0
# No spaces/quotes: OrangeFox injects -DOF_MAINTAINER=\"$(OF_MAINTAINER)\" into CFLAGS;
# "Cerro DualBoot" became #define OF_MAINTAINER ""Cerro DualBoot"" → clang -Werror FAIL,
# so system/bin/recovery never linked and recovery.img was a hollow ramdisk (2026-10-15).
OF_MAINTAINER := Cerro_DualBoot

TARGET_SCREEN_DENSITY := 460
TARGET_SCREEN_HEIGHT := 2480
TARGET_SCREEN_WIDTH := 1116

BUILD_BROKEN_DUP_RULES := true
BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true
ALLOW_MISSING_DEPENDENCIES := true
