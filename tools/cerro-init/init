# s5ex: Qualcomm ADSP + WSA/WCD sound card
cat >/sysroot/usr/local/sbin/cerro-audio-up.sh <<'AUDIOEOF'
#!/bin/sh
KVER=$(uname -r)
BASE=/lib/modules/$KVER
log() { echo "cerro-audio: $*" >/dev/kmsg 2>/dev/null || echo "cerro-audio: $*"; }
# Prefer modprobe (resolves deps). Fallback insmod by path.
loadm() {
  m=$1
  mn=$(echo "$m" | tr '-' '_')
  lsmod 2>/dev/null | grep -q "^$mn " && return 0
  if command -v modprobe >/dev/null 2>&1; then
    modprobe "$m" 2>/dev/null && return 0
  fi
  f=$(find "$BASE" -name "${m}.ko" -o -name "${mn}.ko" 2>/dev/null | head -1)
  [ -n "$f" ] || return 1
  insmod "$f"
}
# modules.dep on rootfs is often incomplete for late-copied .ko — refresh once
if [ ! -f /run/cerro-audio-depmod.stamp ]; then
  depmod -a 2>/dev/null || true
  touch /run/cerro-audio-depmod.stamp 2>/dev/null || true
fi
if [ ! -f /lib/firmware/qcom/sm8650/adsp.mdt ]; then
  mkdir -p /mnt/modem /lib/firmware/qcom/sm8650
  i=0
  while [ $i -lt 20 ]; do
    [ -e /dev/disk/by-partlabel/modem_a ] && break
    sleep 0.5
    i=$((i + 1))
  done
  if mount -t vfat -o ro /dev/disk/by-partlabel/modem_a /mnt/modem 2>/dev/null; then
    cp -a /mnt/modem/image/adsp.mdt /mnt/modem/image/adsp.b* \
      /mnt/modem/image/adsp_dtb.mdt /mnt/modem/image/adsp_dtb.b* \
      /mnt/modem/image/adspr.jsn /mnt/modem/image/adsps.jsn /mnt/modem/image/adspua.jsn \
      /lib/firmware/qcom/sm8650/ 2>/dev/null || true
    umount /mnt/modem 2>/dev/null || true
    log "copied ADSP fw from modem_a"
  else
    log "warn: could not mount modem_a for ADSP fw"
  fi
fi
# s5fe: bring ADSP up BEFORE apr/q6prm/macros — otherwise va_macro defers forever
# on "unable to get macro clock" (q6prm-lpass-clocks needs gpr+ADSP).
# s5fi: qmi_helpers BEFORE sysmon/PAS — otherwise PAS Unknown symbol and no remoteproc start
# (ath12k also pulls qmi later; without it early, ADSP never starts before card wait ends)
for m in soundcore snd snd-timer snd-pcm snd-hwdep snd-compress \
  qmi_helpers qcom-memshare qcom_pil_info qcom_common qcom_sysmon qcom_q6v5 \
  rpmsg_core qcom_glink_smem qcom_q6v5_pas; do
  if loadm "$m"; then log "loaded $m"; else log "warn: load $m failed"; fi
done
# PAS serialize (was wrongly After=cellular-prepare / UIM): 12/12 hard-resets
# started ADSP while MPSS still offline. Wait for modem running here — do NOT
# gate on cerro-cellular-prepare (that only delayed audio past SDDM/PipeWire).
mpss_ok=0
i=0
while [ $i -lt 120 ]; do
  for rp in /sys/class/remoteproc/remoteproc*; do
    [ -e "$rp/name" ] || continue
    name=$(cat "$rp/name" 2>/dev/null)
    case "$name" in
      modem|mpss|*modem*)
        st=$(cat "$rp/state" 2>/dev/null)
        if [ "$st" = "offline" ]; then
          log "starting $name before ADSP (serialize)"
          sync
          echo start >"$rp/state" 2>/dev/null || log "warn: start $name rc=$?"
          st=$(cat "$rp/state" 2>/dev/null)
        fi
        log "remoteproc $name state=$st"
        [ "$st" = "running" ] && mpss_ok=1
        ;;
    esac
  done
  [ "$mpss_ok" = 1 ] && break
  sleep 0.5
  i=$((i + 1))
done
if [ "$mpss_ok" != 1 ]; then
  log "FATAL: MPSS not running — refusing ADSP start (PAS race)"
  exit 1
fi
for rp in /sys/class/remoteproc/remoteproc*; do
  [ -e "$rp/name" ] || continue
  name=$(cat "$rp/name" 2>/dev/null)
  st=$(cat "$rp/state" 2>/dev/null)
  log "remoteproc $name state=$st"
  case "$name" in
    adsp|lpass|*adsp*)
      if [ "$st" = "offline" ] && [ -f /lib/firmware/qcom/sm8650/adsp.mdt ]; then
        log "starting $name (fw ready, MPSS up)"
        sync
        echo start >"$rp/state" 2>/dev/null || log "warn: start $name rc=$?"
      fi
      i=0
      while [ $i -lt 30 ]; do
        st=$(cat "$rp/state" 2>/dev/null)
        [ "$st" = "running" ] && break
        sleep 0.5
        i=$((i + 1))
      done
      log "remoteproc $name state=$(cat "$rp/state" 2>/dev/null)"
      ;;
  esac
done
# Wait for glink channel that hosts GPR (qcom,gpr / adsp_apps)
i=0
while [ $i -lt 40 ]; do
  if ls /sys/bus/rpmsg/devices/*adsp_apps* >/dev/null 2>&1; then
    log "rpmsg adsp_apps present"
    break
  fi
  sleep 0.25
  i=$((i + 1))
done
# Now APR/GPR + AudioReach + LPASS clocks + macros + machine
for m in qcom_pdr_msg pdr_interface apr \
  slimbus slim-qcom-ngd-ctrl \
  soundwire-bus regmap-sdw regmap-slimbus soundwire-qcom \
  snd-soc-core \
  snd-q6dsp-common snd-q6apm q6prm q6prm-clocks q6apm-dai q6apm-lpass-dais \
  snd-soc-qcom-common snd-soc-qcom-sdw \
  pinctrl-lpass-lpi pinctrl-sm8650-lpass-lpi \
  snd-soc-lpass-macro-common snd-soc-lpass-rx-macro snd-soc-lpass-tx-macro \
  snd-soc-lpass-va-macro snd-soc-lpass-wsa-macro \
  snd-soc-wcd-common snd-soc-wcd-classh snd-soc-wcd-mbhc \
  snd-soc-wcd939x-sdw snd-soc-wcd939x snd-soc-wsa884x \
  snd-soc-sc8280xp; do
  if loadm "$m"; then log "loaded $m"; else log "warn: load $m failed"; fi
done
# Ensure topology for sound model SM8650-CERRO (s5fg)
mkdir -p /lib/firmware/qcom/sm8650
if [ ! -f /lib/firmware/qcom/sm8650/SM8650-CERRO-tplg.bin ]; then
  if [ -f /lib/firmware/qcom/sm8650/SM8650-CERRO-tplg.bin.zst ]; then
    log "warn: CERRO tplg only as .zst (need decompressed .bin)"
  elif [ -f /lib/firmware/qcom/sm8650/SM8650-QRD-tplg.bin ]; then
    cp -a /lib/firmware/qcom/sm8650/SM8650-QRD-tplg.bin /lib/firmware/qcom/sm8650/SM8650-CERRO-tplg.bin
    log "staged CERRO tplg from QRD bin"
  else
    log "warn: missing SM8650-CERRO-tplg.bin"
  fi
else
  log "CERRO tplg present ($(wc -c </lib/firmware/qcom/sm8650/SM8650-CERRO-tplg.bin) bytes)"
fi
# s5fh: SoundWire/ASoC probe often finishes AFTER first sleep5 — poll for card
i=0
while [ $i -lt 90 ]; do
  if grep -q SM8650CERRO /proc/asound/cards 2>/dev/null; then
    log "card ready after ${i}s"
    break
  fi
  sleep 1
  i=$((i + 1))
done
log "cards=$(cat /proc/asound/cards 2>/dev/null | tr '\n' ';')"
aplay -l 2>/dev/null | head -20 | while read -r L; do log "$L"; done
# s5fv: AW88261 via PRIMARY_MI2S → MultiMedia1 (device 0); not WSA MultiMedia2
if grep -q SM8650CERRO /proc/asound/cards 2>/dev/null; then
  amixer -c0 cset name='PRIMARY_MI2S_RX Audio Mixer MultiMedia1' on,on >/dev/null 2>&1 || \
    amixer -c0 cset name='PRIMARY_MI2S_RX Audio Mixer MultiMedia1' 1,1 >/dev/null 2>&1 || true
  log "PRIMARY_MI2S MultiMedia1 speaker route applied"
else
  log "warn: no SM8650CERRO card after wait — skip mixer route"
fi
exit 0
AUDIOEOF
