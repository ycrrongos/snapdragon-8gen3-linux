  elif [ -f /sysroot/.cerro-native-debian ] && \
       [ -e /sysroot/sbin/init ] && \
       [ -x /sysroot/cerro-sd-prep ]; then
    SWITCH_ROOT=/sysroot
    log "native Debian flat root on cerro_linux"
  else
    log "FAIL: Debian root is incomplete; refusing native switch"
    echo "FAIL: incomplete Debian root" >/dev/tty1 2>/dev/null || true
    sleep 120
    reboot -f 2>/dev/null || echo b >/proc/sysrq-trigger
  fi

  # Install into the native-Debian root (nested /debian-root or flat cerro_linux).
  # Writable remote EFS was explicitly authorized after byte-exact backups of
  # modemst1, modemst2, fsc, and fsg were verified.
  mkdir -p "$SWITCH_ROOT/etc/systemd/system/rmtfs.service.d" \
    "$SWITCH_ROOT/etc/systemd/system/pd-mapper.service.d" \
    "$SWITCH_ROOT/etc/systemd/system/ModemManager.service.d" \
    "$SWITCH_ROOT/usr/local/sbin" \
    "$SWITCH_ROOT/usr/local/libexec" \
    "$SWITCH_ROOT/etc/systemd/system/multi-user.target.wants"

  # The generic module staging above targets the outer userdata root.  Native
  # Debian lives below /debian-root, so carry this boot candidate's external
  # memshare module across that second root boundary before systemd starts.
  NATIVE_KVER=$(uname -r)
  NATIVE_MEMSHARE="/lib/modules/$NATIVE_KVER/extra/qcom-memshare.ko"
  if [ -f "$NATIVE_MEMSHARE" ]; then
    mkdir -p "$SWITCH_ROOT/lib/modules/$NATIVE_KVER/extra"
    if cp -a "$NATIVE_MEMSHARE" \
        "$SWITCH_ROOT/lib/modules/$NATIVE_KVER/extra/qcom-memshare.ko" && \
       cmp "$NATIVE_MEMSHARE" \
        "$SWITCH_ROOT/lib/modules/$NATIVE_KVER/extra/qcom-memshare.ko"; then
      depmod -b "$SWITCH_ROOT" "$NATIVE_KVER" 2>/dev/null || \
        log "WARN: native Debian memshare depmod failed"
      log "staged qcom-memshare into native Debian root"
    else
      log "WARN: failed to stage qcom-memshare into native Debian root"
    fi
  else
    log "WARN: qcom-memshare absent from embedded module tree"
  fi
  if modprobe qcom-memshare 2>/dev/null; then
    log "loaded qcom-memshare before native Debian systemd"
  else
    log "WARN: early native Debian qcom-memshare load failed"
  fi
  cat >"$SWITCH_ROOT/etc/systemd/system/cerro-remoteproc-prepare.service" <<'REMOTEPROCEOF'
[Unit]
Description=Cerro remoteproc drivers before PD mapper and modem startup
After=local-fs.target systemd-modules-load.service
Before=pd-mapper.service rmtfs.service cerro-audio.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/modprobe rmtfs_mem
ExecStart=/sbin/modprobe qcom-memshare
ExecStart=/sbin/modprobe qcom_q6v5_pas
ExecStart=/sbin/modprobe ipa
ExecStart=/sbin/modprobe qrtr_smd
ExecStart=/sbin/modprobe rmnet

[Install]
WantedBy=multi-user.target
REMOTEPROCEOF
  cat >"$SWITCH_ROOT/etc/systemd/system/pd-mapper.service.d/cerro-remoteproc-order.conf" <<'PDMAPPEREOF'
[Unit]
Requires=cerro-remoteproc-prepare.service
After=cerro-remoteproc-prepare.service
PDMAPPEREOF
  rm -f "$SWITCH_ROOT/etc/systemd/system/rmtfs.service.d/cerro-read-only.conf"
  cat >"$SWITCH_ROOT/etc/systemd/system/rmtfs.service.d/zz-cerro-writable.conf" <<'RMTFSEOF'
[Unit]
Requires=cerro-remoteproc-prepare.service tqftpserv.service pd-mapper.service
After=local-fs.target systemd-modules-load.service cerro-remoteproc-prepare.service tqftpserv.service pd-mapper.service

[Service]
ExecStartPre=-/sbin/modprobe rmtfs_mem
ExecStartPre=-/sbin/modprobe qcom-memshare
ExecStartPre=-/sbin/modprobe qcom_q6v5_pas
ExecStartPre=-/sbin/modprobe ipa
ExecStartPre=-/sbin/modprobe qrtr_smd
ExecStartPre=-/sbin/modprobe rmnet
ExecStart=
ExecStart=/usr/bin/rmtfs -P -s
RMTFSEOF
  if [ -f /cerro-pdmap-stage.sh ] && \
     [ -f /cerro-pdmap-stage.service ] && \
     [ -f /cerro-pdmap-stage-order.conf ]; then
    cp /cerro-pdmap-stage.sh \
      "$SWITCH_ROOT/usr/local/sbin/cerro-pdmap-stage.sh"
    cp /cerro-pdmap-stage.service \
      "$SWITCH_ROOT/etc/systemd/system/cerro-pdmap-stage.service"
    cp /cerro-pdmap-stage-order.conf \
      "$SWITCH_ROOT/etc/systemd/system/pd-mapper.service.d/zz-cerro-pdmap-stage.conf"
    chmod 755 "$SWITCH_ROOT/usr/local/sbin/cerro-pdmap-stage.sh"
    chmod 644 "$SWITCH_ROOT/etc/systemd/system/cerro-pdmap-stage.service"
    chmod 644 \
      "$SWITCH_ROOT/etc/systemd/system/pd-mapper.service.d/zz-cerro-pdmap-stage.conf"
  else
    log "WARN: pd-map staging payload absent; leaving existing root files"
  fi
  if [ -f /cerro-cellular-meta.sh ] && \
     [ -f /cerro-qmi-dms-set-meta.py ] && \
     [ -f /cerro-cellular-meta.service ] && \
     [ -f /cerro-cellular-prepare.sh ] && \
     [ -f /cerro-cellular-prepare.service ] && \
     [ -f /cerro-modemmanager-order.conf ]; then
    cp /cerro-cellular-meta.sh \
      "$SWITCH_ROOT/usr/local/sbin/cerro-cellular-meta.sh"
    cp /cerro-qmi-dms-set-meta.py \
      "$SWITCH_ROOT/usr/local/libexec/cerro-qmi-dms-set-meta.py"
    cp /cerro-cellular-meta.service \
      "$SWITCH_ROOT/etc/systemd/system/cerro-cellular-meta.service"
    cp /cerro-cellular-prepare.sh \
      "$SWITCH_ROOT/usr/local/sbin/cerro-cellular-prepare.sh"
    cp /cerro-cellular-prepare.service \
      "$SWITCH_ROOT/etc/systemd/system/cerro-cellular-prepare.service"
    cp /cerro-modemmanager-order.conf \
      "$SWITCH_ROOT/etc/systemd/system/ModemManager.service.d/cerro-cellular-order.conf"
    chmod 755 \
      "$SWITCH_ROOT/usr/local/sbin/cerro-cellular-meta.sh" \
      "$SWITCH_ROOT/usr/local/libexec/cerro-qmi-dms-set-meta.py" \
      "$SWITCH_ROOT/usr/local/sbin/cerro-cellular-prepare.sh"
    chmod 644 \
      "$SWITCH_ROOT/etc/systemd/system/cerro-cellular-meta.service" \
      "$SWITCH_ROOT/etc/systemd/system/cerro-cellular-prepare.service" \
      "$SWITCH_ROOT/etc/systemd/system/ModemManager.service.d/cerro-cellular-order.conf"
  else
    log "WARN: early cellular meta payload absent; leaving existing root files"
  fi
  rm -f "$SWITCH_ROOT/etc/systemd/system/rmtfs.service"
  ln -sfn /usr/lib/systemd/system/rmtfs.service \
    "$SWITCH_ROOT/etc/systemd/system/multi-user.target.wants/rmtfs.service"
  ln -sfn /etc/systemd/system/cerro-remoteproc-prepare.service \
    "$SWITCH_ROOT/etc/systemd/system/multi-user.target.wants/cerro-remoteproc-prepare.service"
  ln -sfn /etc/systemd/system/cerro-pdmap-stage.service \
    "$SWITCH_ROOT/etc/systemd/system/multi-user.target.wants/cerro-pdmap-stage.service"
  ln -sfn /etc/systemd/system/cerro-cellular-meta.service \
    "$SWITCH_ROOT/etc/systemd/system/multi-user.target.wants/cerro-cellular-meta.service"
  ln -sfn /etc/systemd/system/cerro-cellular-prepare.service \
    "$SWITCH_ROOT/etc/systemd/system/multi-user.target.wants/cerro-cellular-prepare.service"
  rm -f "$SWITCH_ROOT/etc/systemd/system/multi-user.target.wants/qrtr-ns.service"
  ln -sfn /dev/null "$SWITCH_ROOT/etc/systemd/system/qrtr-ns.service"
  log "native Debian cellular: stock PD maps + remoteproc -> tqftp/pd-mapper -> writable rmtfs -> stock meta -> UIM; userspace qrtr-ns masked"

  echo "BANK_MEM $MEMLINE" >"$SWITCH_ROOT/cerro-bank-mem.txt" 2>/dev/null || true
  echo "native-debian $(cat /proc/uptime) $(uname -r)" \
    >"$SWITCH_ROOT/cerro-native-switched" 2>/dev/null || true
  log "native Debian root bind-mounted; switch_root -> Debian systemd"
  printf '\033[2J\033[HNative Debian 13 switch_root — watch for login banner\n' >/dev/tty1 2>/dev/null || true
else
  printf '\033[2J\033[Hs5ci switch_root — watch for login banner\n' >/dev/tty1 2>/dev/null || true
fi
sleep 2
exec switch_root "$SWITCH_ROOT" /cerro-sd-prep

log "switch_root FAILED"
sleep 120
reboot -f 2>/dev/null || echo b >/proc/sysrq-trigger
while true; do sleep 3600; done
