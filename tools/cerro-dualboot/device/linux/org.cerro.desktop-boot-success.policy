<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
 <action id="org.cerro.desktop-boot-success">
  <description>Confirm successful Cerro desktop boot</description>
  <message>Confirm this active Cerro slot after desktop entry</message>
  <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
  <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/cerro-switch/desktop-boot-success.py</annotate>
 </action>
</policyconfig>
